{
  "name": "Cobros a Reparo pendientes (cada 10 min)",
  "description": "Auditoría B-40: reenvía a Reparo los cobros de reparaciones que no llegaron al momento.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 9-21 * * 1-6",
      "one_time_date": null,
      "timezone": "Europe/Madrid",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "cobros_reparo",
      "namespace": "base44",
      "version": "1.0"
    },
    "do": [
      {
        "reenviar_cobros": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "function_name": "reparoSyncSweep",
            "args": {}
          },
          "x-base44": {
            "title": "Reenviar cobros a Reparo",
            "description": "Solo filas pendientes de ReparoSync"
          }
        }
      }
    ]
  }
}
