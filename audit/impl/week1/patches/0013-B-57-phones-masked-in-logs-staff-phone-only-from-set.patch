+// =============================================================================
+// duplicatesReport — clientes duplicados en WhatsApp Inbox Pro (auditoría B-56).
+// Solo informa (admin): agrupa Customers por teléfono normalizado (34XXXXXXXXX) y
+// por DNI. No une nada automáticamente; para unir se usa la pantalla Clientes.
+// =============================================================================
+import { createClientFromRequest } from 'npm:@base44/sdk@0.8.54';
+
+const rows = (x: any): any[] => (Array.isArray(x) ? x : (x?.items || []));
+function e164(raw: any) {
+  let d = String(raw || '').replace(/\D/g, '');
+  if (d.startsWith('0034')) d = d.slice(2);
+  if (d.length === 9) d = '34' + d;
+  return d.length >= 11 ? d : '';
+}
+
+Deno.serve(async (req) => {
+  const base44 = createClientFromRequest(req);
+  const user = await base44.auth.me().catch(() => null);
+  if (user?.role !== 'admin') return Response.json({ error: 'forbidden' }, { status: 403 });
+  const sr = base44.asServiceRole.entities;
+  const all: any[] = [];
+  for (let skip = 0; skip < 50000; skip += 500) {
+    const page = rows(await sr.Customers.filter({}, 'created_date', 500, skip, ['id', 'full_name', 'phone_number', 'raw_phone', 'dni', 'created_date']));
+    all.push(...page);
+    if (page.length < 500) break;
+  }
+  const group = (key: (c: any) => string) => {
+    const m = new Map<string, any[]>();
+    for (const c of all) { const k = key(c); if (k) m.set(k, [...(m.get(k) || []), c]); }
+    return [...m.entries()].filter(([, list]) => list.length > 1)
+      .map(([k, list]) => ({ key: k, count: list.length, customers: list.map((c) => ({ id: c.id, name: c.full_name || '', created: c.created_date })) }))
+      .sort((a, b) => b.count - a.count);
+  };
+  const byPhone = group((c) => e164(c.phone_number || c.raw_phone));
+  const byDni = group((c) => String(c.dni || '').toUpperCase().replace(/[^0-9A-Z]/g, ''));
+  return Response.json({ scanned: all.length, by_phone: { groups: byPhone.length, top: byPhone.slice(0, 100) }, by_dni: { groups: byDni.length, top: byDni.slice(0, 100) } });
+});
