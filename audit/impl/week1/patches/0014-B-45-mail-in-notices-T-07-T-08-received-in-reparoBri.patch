--- /dev/null
+++ b/cls_out.cjs
@@ -0,0 +1,58 @@
+"use strict";
+const norm = (s) => String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
+const collapse = (s) => String(s || '').replace(/\s+/g, ' ').trim();
+function classify(statusName) {
+    const s = norm(statusName);
+    if (s.includes('entregado') && s.includes('resena'))
+        return 'close_review';
+    if (s.includes('entregado'))
+        return 'close';
+    // Audit B-45 (T-07/T-08, D-20/D-34): mail-in repairs.
+    if (s.includes('mensajeria') && s.includes('recibid'))
+        return 'mail_received';
+    if (s.includes('mensajeria'))
+        return 'mail_in';
+    if (s.includes('enviado') && s.includes('cliente'))
+        return 'mail_sent';
+    // Audit B-24 (T-01/T-02): parts notices.
+    if (s.includes('esperando') && s.includes('material'))
+        return 'material';
+    if (s.includes('pieza') && s.includes('recibid'))
+        return 'pieza_recibida';
+    if (s.includes('no') && s.includes('reparacion'))
+        return 'no_repair';
+    if (s.includes('listo') && (s.includes('whatsapp') || s.includes('wsp')))
+        return 'listo_wa';
+    if (s.includes('listo'))
+        return 'listo_voice';
+    if (s.includes('contactar'))
+        return 'contactar';
+    if (s.includes('presupuesto') && s.includes('enviar'))
+        return 'presupuesto';
+    if (s.includes('conversaci'))
+        return 'iniciar';
+    if (s.includes('nuevo'))
+        return 'nuevo';
+    return 'other';
+}
+function readyDate(iso) {
+    const d = new Date(iso);
+    return isNaN(d.getTime()) ? '' : d.toLocaleDateString('es-ES', { timeZone: 'Europe/Madrid', day: 'numeric', month: 'numeric' });
+}
+function buildReminder(kind, r, sig) {
+    const dev = r.device_model || 'dispositivo';
+    switch (kind) {
+        case 'budget_24h':
+            if (!r.estimated_cost)
+                return null;
+            return `Hola ${r.client_name}, le recordamos el presupuesto de su ${dev} (Orden #${r.id}): ${r.estimated_cost}. ¿Desea que sigamos adelante? Puede responder a este mensaje.${sig}`;
+        case 'uncollected_3':
+            return `Hola ${r.client_name}, su ${dev} (Orden #${r.id}) está listo para recoger${r.since ? ` desde el ${readyDate(r.since)}` : ''}. Le esperamos en C/ Germanies 74 bajo, Torrent. Horario: L-V 9:30-14:00 y 17:00-20:30, sáb 10:00-14:00.${sig}`;
+        case 'uncollected_7':
+        case 'uncollected_15':
+            return `Hola ${r.client_name}, le recordamos que su ${dev} (Orden #${r.id}) sigue pendiente de recoger en nuestra tienda. Si necesita que le guardemos el equipo unos días más o tiene alguna duda, responda a este mensaje.${sig}`;
+        default:
+            return null;
+    }
+}
+module.exports = { classify, buildReminder };
