index 76a598c..3ab1b03 100644
--- a/src/components/conversaciones/CustomerSidebar.jsx
+++ b/src/components/conversaciones/CustomerSidebar.jsx
@@ -5,7 +5,7 @@
 import { useState, useEffect } from 'react';
 import { base44 } from '@/api/base44Client';
 import { toast } from '@/components/ui/use-toast';
-import { X, Wrench, Brain, StickyNote, Activity, ExternalLink, AlertTriangle } from 'lucide-react';
+import { X, Wrench, Brain, StickyNote, Activity, ExternalLink, AlertTriangle, Plus } from 'lucide-react';
 import { Textarea } from '@/components/ui/textarea';
 import InternalNotes from '@/components/conversaciones/InternalNotes';
 import CustomFieldsSection from '@/components/conversaciones/CustomFieldsSection';
@@ -102,6 +102,12 @@ export default function CustomerSidebar({ conversation, onClose, onRefresh, isMo
                   <AlertTriangle size={11} /> Reparo no responde: mostrando la copia antigua
                 </p>
               )}
+              {/* Audit B-38: new Reparo ticket with this chat's client (or phone + name) prefilled. */}
+              <a href={`${REPARO_URL}/tickets/nuevo?${reparoClient?.id ? `client=${encodeURIComponent(reparoClient.id)}` : `phone=${encodeURIComponent(phone)}&name=${encodeURIComponent(conversation?.customer_name || '')}`}`}
+                target="_blank" rel="noopener noreferrer"
+                className="mb-1.5 flex items-center justify-center gap-1.5 rounded-lg bg-primary px-2 py-1.5 text-xs font-semibold text-white hover:opacity-90">
+                <Plus size={12} /> Crear reparación
+              </a>
               {reparoClient && (
                 <a href={reparoClient.reparo_url || REPARO_URL + '/clientes'} target="_blank" rel="noopener noreferrer"
                   className="mb-1.5 block rounded-lg border border-border bg-gray-50 px-2 py-1.5 text-xs hover:border-primary">
