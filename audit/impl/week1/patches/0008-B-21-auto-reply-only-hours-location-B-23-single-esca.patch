 3 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/base44/functions/escalateWaiting/entry.ts b/base44/functions/escalateWaiting/entry.ts
index 21e3719..a4196cc 100644
--- a/base44/functions/escalateWaiting/entry.ts
+++ b/base44/functions/escalateWaiting/entry.ts
@@ -169,6 +169,9 @@ Deno.serve(async (req) => {
     const phone1 = (s.escalation_phone_1 || fallbackPhone).replace(/\D/g, '');
     const phone2 = (s.escalation_phone_2 || fallbackPhone).replace(/\D/g, '');
     const dryRun = s.escalation_dry_run === 'true';
+    // Audit B-23 / D-26: one escalation level to the admin mobile. The second (60 min)
+    // level duplicated the alert to the same number; it only runs if switched on again.
+    const level2 = s.escalation_level2_enabled === 'true';
 
     const now = Date.now();
 
@@ -199,7 +202,7 @@ Deno.serve(async (req) => {
       const start = waitingStart(c);
       const mins = openMinutesBetween(start, now, s);
       const name = c.customer_name || c.customer_phone || 'Cliente';
-      if (mins >= lvl2 && ms(c.escalation60_at) < start) hit2.push({ c, mins, name });
+      if (level2 && mins >= lvl2 && ms(c.escalation60_at) < start) hit2.push({ c, mins, name });
       else if (mins >= lvl1 && ms(c.escalation30_at) < start) hit1.push({ c, mins, name });
     }
 
diff --git a/base44/functions/libraryAutoReply/entry.ts b/base44/functions/libraryAutoReply/entry.ts
index 34796a9..724de88 100644
--- a/base44/functions/libraryAutoReply/entry.ts
+++ b/base44/functions/libraryAutoReply/entry.ts
@@ -220,6 +220,10 @@ Deno.serve(async (req) => {
     const reasons: string[] = [`topic:${entry.topic_key}`, `score:${best.sc}`];
 
     if (entry.automation_level !== 'auto') { await log('blocked', [...reasons, 'draft_only'], { matched_category: entry.topic_key }); return out({ skipped: 'draft_only' }); }
+    // Audit B-21 (D-04/D-13): only opening hours and location are ever answered automatically,
+    // whatever the library says; every other topic stays a draft for a person.
+    const allowedTopics = String(s.autoreply_topics || 'horario,ubicacion,como_llegar,direccion').split(',').map((x: string) => norm(x.trim())).filter(Boolean);
+    if (!allowedTopics.some((x: string) => norm(entry.topic_key).startsWith(x))) { await log('blocked', [...reasons, 'topic_not_allowed'], { matched_category: entry.topic_key }); return out({ skipped: 'topic_not_allowed' }); }
 
     const open = isOpen(s);
     if (!open && !entry.night_allowed) { await log('blocked', [...reasons, 'closed_not_night_allowed'], { matched_category: entry.topic_key }); return out({ skipped: 'night_not_allowed' }); }
