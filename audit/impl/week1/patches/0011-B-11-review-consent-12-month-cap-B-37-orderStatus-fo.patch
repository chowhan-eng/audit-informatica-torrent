 // =============================================================================
-import { createClientFromRequest } from 'npm:@base44/sdk@0.8.32';
 
 const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
 const cors = {
@@ -16,35 +18,23 @@ const cors = {
   'Access-Control-Allow-Headers': 'Content-Type, X-App-Id',
 };
 
+const REPARO_STATUS = 'https://reparo-812bcab8.base44.app/api/apps/6ae22784825ce515812bcab8/functions/publicStatus';
+
 Deno.serve(async (req) => {
   if (req.method === 'OPTIONS') return new Response(null, { headers: cors });
-  const base44 = createClientFromRequest(req);
-  const sr = base44.asServiceRole.entities;
   const body = await req.json().catch(() => ({}));
   const id = String(body.id || '').trim();
   if (!UUID.test(id)) return Response.json({ error: 'not_found' }, { status: 404, headers: cors });
-
-  const rows = await sr.RepairOrder.filter({ ticket_uuid: id }).catch(() => []);
-  const o = rows[0];
-  if (!o) return Response.json({ error: 'not_found' }, { status: 404, headers: cors });
-
-  let shop = { name: 'Informática Torrent', phone: '', address: '' };
   try {
-    const s = await sr.SystemSettings.filter({ setting_key: 'shop_company' });
-    if (s[0]) { const c = JSON.parse(s[0].setting_value || '{}'); shop = { name: c.name || shop.name, phone: c.phone || '', address: c.address || '' }; }
-  } catch { /* defaults */ }
-
-  const group = o.status_group || '';
-  return Response.json({
-    number: o.order_id,
-    status: o.status_name || '',
-    stage: group,                       // new | in_progress | ready | failed
-    ready: group === 'ready',
-    closed: !o.is_open || group === 'failed',
-    device: [o.device_brand, o.device_model].filter(Boolean).join(' '),
-    created_at: o.hc_created_at || o.created_date || null,
-    estimated_at: o.estimated_at || null,
-    closed_at: o.closed_at || null,
-    shop,
-  }, { headers: cors });
+    const r = await fetch(REPARO_STATUS, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', 'X-App-Id': '6ae22784825ce515812bcab8' },
+      body: JSON.stringify({ id }),
+      signal: AbortSignal.timeout(10000),
+    });
+    const data = await r.json().catch(() => ({}));
+    return Response.json(data, { status: r.status, headers: cors });
+  } catch {
+    return Response.json({ error: 'unavailable' }, { status: 503, headers: cors });
+  }
 });
