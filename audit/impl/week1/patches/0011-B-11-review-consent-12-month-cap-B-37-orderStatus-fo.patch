+        await sr.PendingReviews.update(r.id, { sent: true, send_error: 'no_marketing_consent' });
+        continue;
+      }
+      const previous = await sr.PendingReviews.filter({ phone: r.phone, sent: true }).catch(() => []);
+      const yearAgo = Date.now() - 365 * 86400000;
+      if ((Array.isArray(previous) ? previous : []).some((p: any) => p.id !== r.id && !p.send_error && Date.parse(p.updated_date || p.created_date || 0) >= yearAgo)) {
+        await sr.PendingReviews.update(r.id, { sent: true, send_error: 'already_asked_12_months' });
