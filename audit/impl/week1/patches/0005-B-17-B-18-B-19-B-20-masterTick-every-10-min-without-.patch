diff --git a/base44/functions/masterTick/entry.ts b/base44/functions/masterTick/entry.ts
index dc5829e..5b5825c 100644
--- a/base44/functions/masterTick/entry.ts
+++ b/base44/functions/masterTick/entry.ts
@@ -127,44 +127,32 @@ Deno.serve(async (req) => {
   // ── Cadence schedule ──────────────────────────────────────────────────────
   // Every tick: time-sensitive jobs (shop hours only).
   // Every 3rd tick: broadcasts, retries, alerts (shop hours only).
-  // Open hours, every 6th tick (~few times/day): reviews, NPS.
-  // Off-peak (closed hours), every 12th tick (~once or twice/day): autoKBExtract, watchdog.
+  // (Schedule notes: see the B-17 comment below.)
 
+  // Audit B-17: the tick runs every 10 min (workflow) in shop hours. HelloClient
+  // polling, watchdog, libraryShadowReport, NPS and broadcasts no longer run
+  // (HelloClient is cut over; the others were switched off in Phase 5).
   if (open) {
-    await run('pollHelloClient');
     await run('sendScheduledMessages');
-    // Improvement Plan Phase 1: reminders + phone escalation run EVERY tick
-    // while open (was every 3rd tick = up to 45 min late). Internal invokes
-    // cost no automation credits; both are pure DB reads unless something is due.
+    // Reminders + phone escalation run every tick while open.
     await run('processAlerts');
     await run('escalateWaiting');
 
+    // Every 3rd tick (~30 min): retries and due review requests.
     if (tick % 3 === 0) {
-      await run('processBroadcasts');
       await run('retryFailedSends');
-    } else {
-      skipped.push('processBroadcasts', 'retryFailedSends');
-    }
-
-    if (tick % 6 === 0) {
       await run('sendDueReviews');
     } else {
-      skipped.push('sendDueReviews');
+      skipped.push('retryFailedSends', 'sendDueReviews');
     }
-    // sendNPS paused 2026-10-30 (audit, approved by Joney): its loop of up to 200
-    // sequential reads hit the platform read-rate limit on every run and made
-    // concurrent Meta webhooks fail. Re-enable only after it batches its reads.
-    skipped.push('sendNPS');
   } else {
-    skipped.push('pollHelloClient', 'sendScheduledMessages', 'processBroadcasts', 'retryFailedSends', 'processAlerts', 'escalateWaiting', 'sendDueReviews', 'sendNPS');
+    skipped.push('sendScheduledMessages', 'retryFailedSends', 'processAlerts', 'escalateWaiting', 'sendDueReviews');
 
-    // Off-peak maintenance: run a couple of times per closed period.
-    if (tick % 12 === 0) {
+    // Midday break: KB extraction (gated by its own autokb_live setting).
+    if (tick % 6 === 0) {
       await run('autoKBExtract');
-      await run('watchdog');
-      await run('libraryShadowReport'); // Improvement Plan Phase 3 go-live gate (no LLM)
     } else {
-      skipped.push('autoKBExtract', 'watchdog', 'libraryShadowReport');
+      skipped.push('autoKBExtract');
     }
   }
 
