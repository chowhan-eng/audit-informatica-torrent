diff --git a/base44/functions/whatsappWebhook/entry.ts b/base44/functions/whatsappWebhook/entry.ts
index a104a92..2653ba6 100644
--- a/base44/functions/whatsappWebhook/entry.ts
+++ b/base44/functions/whatsappWebhook/entry.ts
@@ -642,6 +642,21 @@ async function handleStatus(db: any, st: any) {
   if (status === 'failed' && Array.isArray(st.errors)) {
     await safeLog(db, 'error', 'whatsappWebhook',
       `Delivery failed to ${st.recipient_id} (code ${st.errors[0]?.code})`, JSON.stringify(st.errors));
+    // Audit B-33: Meta reports some failures only later (e.g. 131026 undeliverable, 131047
+    // window closed). They now land in FailedSend so they appear in the Hoy panel and brief;
+    // no automatic retry (the message already reached Meta once). One row per message.
+    const code = String(st.errors[0]?.code || '');
+    const existingFail = await db.entities.FailedSend.filter({ retry_data: JSON.stringify({ meta_message_id: metaId }) }).catch(() => []);
+    if (!(Array.isArray(existingFail) && existingFail.length)) {
+      await db.entities.FailedSend.create({
+        to_phone: String(st.recipient_id || ''), conversation_id: row?.conversation_id || null, purpose: 'status',
+        retry_data: JSON.stringify({ meta_message_id: metaId }),
+        error_code: code, error_title: String(st.errors[0]?.title || st.errors[0]?.message || '').slice(0, 200),
+        error_detail: JSON.stringify(st.errors).slice(0, 2000),
+        classification: ['131047', '131042'].includes(code) ? 'hold' : 'permanent',
+        attempts: 0, next_retry_at: null, status: ['131047', '131042'].includes(code) ? 'hold' : 'dead',
+      }).catch(() => {});
+    }
   }
 }
 
